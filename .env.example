# Runtime user/group id the container drops to after fixing the ownership of
# ./config, ./data and ./logs (the entrypoint starts as root, chowns those
# directories, then drops privileges).
#
# Use your login user on the server:
#   PUID=$(id -u)
#   PGID=$(id -g)
# The defaults (1000:1000) match the first regular user on most Linux systems.
# Set PUID=0 and PGID=0 to keep running as root (files stay root-owned).
PUID=1000
PGID=1000

# Bump this value (any change) to force Docker to re-fetch the application
# sources from git on the next build. Without it the cached clone is reused and
# new commits on the branch are ignored. Example: RXCLUSTER_CACHEBUST=20260101.
RXCLUSTER_CACHEBUST=1
