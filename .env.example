# Host user/group id the container runs as, so bind-mounted files in ./config,
# ./data and ./logs are owned by you (no sudo needed to edit them).
#
# On the server, set these to your login user:
#   PUID=$(id -u)
#   PGID=$(id -g)
# The defaults (1000:1000) match the first regular user on most Linux systems.
PUID=1000
PGID=1000
